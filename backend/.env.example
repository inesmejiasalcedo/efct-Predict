# ============================================================
# EFCT Predict - configuracion de ejemplo
# 1. Copia este archivo como .env  (copy .env.example .env)
# 2. Rellena los valores. El archivo .env NUNCA se sube a git.
# ============================================================

APP_ENV=development

# Base de datos. Local: SQLite (no hay que instalar nada).
# En la nube: postgresql://usuario:clave@host:5432/efct
DATABASE_URL=sqlite:///./efct.db

# Clave para firmar las sesiones (JWT). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
TOKEN_MINUTES=480

# Cuenta administradora (panel de admin). Se crea al iniciar el backend.
# La contrasena debe tener 8+ caracteres, letras y numeros.
ADMIN_EMAIL=admin@efct.pe
ADMIN_PASSWORD=

# ---------------- APIs externas ----------------
# OpenWeather (clima): https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
# TomTom (trafico): https://developer.tomtom.com/user/me/apps
TOMTOM_API_KEY=
# BCRP (tipo de cambio e inflacion) es publica: no necesita key.

# Si falta una key, la app usa datos simulados marcados como tales.
ALLOW_SIMULATED_DATA=true

# ---------------- Refresco automatico (minutos) ----------------
SCHEDULER_ENABLED=true
WEATHER_REFRESH_MINUTES=30
TRAFFIC_REFRESH_MINUTES=15
MACRO_REFRESH_MINUTES=720

# Origenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=America/Lima
